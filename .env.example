# Configuration overrides for the routine pipeline.
# Copy to .env and set the values you want to override. Values not present
# fall back to defaults in config.py.
#
# Scraper:
# Keep HEADLESS=false on Linux: true headless Chrome gets challenged by
# Cloudflare (persistent "Just a moment..." on the portal). Scheduled and
# scripts/run_routine.sh runs stay invisible anyway because the script runs
# the scraper under xvfb-run and the scraper forces --ozone-platform=x11, so
# Chrome renders on the virtual X display rather than your screen.
HEADLESS=false
# Pin the exact Chrome binary (else auto-detected: PATH scan on Linux, plus
# the well-known .app bundle on macOS and Program Files installs on Windows).
#CHROME_BINARY_PATH=/usr/bin/google-chrome-stable
# Formatter:
SPREADSHEET_NAME=CSE-03_B_ClassRoutine
# Name of the worksheet the raw scraped data is written to. The sorted output
# goes to 'NewMain'; only that name is fixed in code.
TARGET_SHEET_NAME=backend
# Refuse to publish scraper output older than this many hours (default 48).
# Protects against a crashed scrape leaving the previous run's JSON behind.
#MAX_DATA_AGE_HOURS=48
# Logging:
LOG_LEVEL=INFO