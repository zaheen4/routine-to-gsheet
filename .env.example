# Configuration overrides for the routine pipeline.
# Copy to .env and set the values you want to override. Values not present
# fall back to defaults in config.py.
#
# Scraper:
PREFERRED_BROWSER=chrome
HEADLESS=false
# Pin the exact Chrome binary (else auto-detected: google-chrome-stable,
# google-chrome, chromium-browser, chromium). The detected major version is
# matched against the chromedriver undetected-chromedriver downloads.
#CHROME_BINARY_PATH=/usr/bin/google-chrome-stable
# Formatter:
SPREADSHEET_NAME=CSE-03_B_ClassRoutine
APP_SCRIPT_ID=your_app_script_id
# Logging:
LOG_LEVEL=INFO